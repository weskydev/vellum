<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vellum.Controls.MarkdownHelp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed"
    KeyDown="Root_KeyDown">

    <!-- Markdown cheat sheet: what you type on the left, what you get on the right -->
    <Grid Background="#33000000" Tapped="Backdrop_Tapped">
        <Border
            Style="{StaticResource FloatingPanelStyle}"
            MaxWidth="820"
            Margin="24,48,24,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Tapped="Panel_Tapped">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="24,16,12,8">
                    <StackPanel>
                        <TextBlock x:Uid="HelpTitle" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Uid="HelpSubtitle" Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                    <Button x:Name="CloseButton" x:Uid="HelpClose" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Padding="38,6,38,0" ColumnSpacing="32" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="HelpYouType" Style="{StaticResource StatusTextStyle}" />
                    <TextBlock x:Uid="HelpYouGet" Grid.Column="1" Style="{StaticResource StatusTextStyle}" />
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,26,0,0" Padding="24,0,24,8" HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="Rows" Spacing="6" />
                </ScrollViewer>

                <TextBlock x:Uid="HelpTips" Grid.Row="2" Margin="24,8,24,16" Style="{StaticResource SettingsDescriptionStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
