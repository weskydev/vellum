<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vellum.Controls.LibraryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Vellum.Models">

    <Grid Padding="14,12,10,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title, new note, close -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0" />
            <Button x:Name="NewButton" x:Uid="LibraryNew" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="New_Click">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
            </Button>
            <Button x:Uid="LibraryClose" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="Close_Click">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <TextBox
            x:Name="SearchBox"
            x:Uid="LibrarySearch"
            Grid.Row="1"
            IsSpellCheckEnabled="False"
            TextChanged="SearchBox_TextChanged"
            KeyDown="SearchBox_KeyDown" />

        <!-- Tags: click one to see only its notes -->
        <ScrollViewer
            x:Name="TagScroller"
            Grid.Row="2"
            HorizontalScrollMode="Auto"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TagStrip" Orientation="Horizontal" Spacing="6" />
        </ScrollViewer>

        <ListView
            x:Name="NoteList"
            Grid.Row="3"
            Margin="-4,0,-4,0"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="NoteList_ItemClick"
            KeyDown="NoteList_KeyDown">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="10,8,10,8" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:NoteListItem">
                    <Grid RowSpacing="2" Background="Transparent" ContextRequested="Item_ContextRequested">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <!-- Small accent dot: open in a tab -->
                            <Ellipse Grid.Column="1" Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{ThemeResource VellumAccentBrush}" Visibility="{x:Bind OpenVisibility}" />
                            <FontIcon Grid.Column="2" Glyph="&#xE718;" FontSize="12" VerticalAlignment="Center"
                                      Foreground="{ThemeResource VellumAccentBrush}" Visibility="{x:Bind PinVisibility}" />
                            <FontIcon Grid.Column="3" Glyph="&#xE72E;" FontSize="12" VerticalAlignment="Center"
                                      Opacity="0.7" Visibility="{x:Bind LockVisibility}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{x:Bind Snippet}" Style="{StaticResource StatusTextStyle}" FontSize="13"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="{x:Bind SnippetVisibility}" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                            <TextBlock Text="{x:Bind Meta}" Style="{StaticResource StatusTextStyle}" FontSize="12" />
                            <TextBlock Text="{x:Bind Tags}" FontSize="12" Foreground="{ThemeResource VellumAccentBrush}"
                                       TextTrimming="CharacterEllipsis" Visibility="{x:Bind TagsVisibility}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Shown when the list is empty -->
        <StackPanel x:Name="EmptyState" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="16,0" Visibility="Collapsed">
            <FontIcon x:Name="EmptyIcon" Glyph="&#xE70B;" FontSize="32" Foreground="{ThemeResource StatusTextBrush}" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource StatusTextStyle}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />
        </StackPanel>

        <!-- Trash -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="TrashToggle" Padding="10,6" Background="Transparent" BorderThickness="0" Click="TrashToggle_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                    <TextBlock x:Name="TrashText" FontSize="13" />
                </StackPanel>
            </ToggleButton>
            <Button x:Name="EmptyTrashButton" x:Uid="LibraryEmptyTrash" Grid.Column="1" Padding="10,6" Visibility="Collapsed" Click="EmptyTrash_Click" />
        </Grid>
    </Grid>
</UserControl>
