<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vellum.Controls.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Vellum.Models"
    Visibility="Collapsed">

    <!-- Clicking anywhere outside the panel closes it -->
    <Grid Background="Transparent" Tapped="Backdrop_Tapped">
        <Border
            x:Name="Panel"
            Style="{StaticResource FloatingPanelStyle}"
            Width="580"
            MaxHeight="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16,44,16,0"
            Padding="8"
            Tapped="Panel_Tapped">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox x:Name="QueryBox" IsSpellCheckEnabled="False" x:Uid="PaletteBox" TextChanged="QueryBox_TextChanged" KeyDown="QueryBox_KeyDown" />

                <ListView
                    x:Name="Results"
                    Grid.Row="1"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="Results_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PaletteCommand">
                            <Grid ColumnSpacing="12" Padding="2,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Shortcut}" Style="{StaticResource StatusTextStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
