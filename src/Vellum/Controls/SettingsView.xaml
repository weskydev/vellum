<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vellum.Controls.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ShortcutNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ShortcutKeysStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="Foreground" Value="{ThemeResource StatusTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- Side panel like Notepads: categories on the left, settings on the right -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Padding="10,14,10,12" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Uid="SettingsHeader" FontSize="20" FontWeight="SemiBold" Margin="10,2,0,14" />
            <ListView x:Name="SectionNav" Grid.Row="1" SelectionMode="Single" SelectionChanged="SectionNav_SelectionChanged" />
        </Grid>

        <Button x:Name="ClosePanelButton" x:Uid="SettingsClose" Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" Canvas.ZIndex="1" Click="ClosePanel_Click">
            <FontIcon Glyph="&#xE711;" FontSize="12" />
        </Button>

        <ScrollViewer x:Name="Scroller" Grid.Column="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" ViewChanged="Scroller_ViewChanged">
            <StackPanel x:Name="ContentPanel" MaxWidth="760" Padding="24,0,28,40" HorizontalAlignment="Stretch">

                <!-- ================= Appearance ================= -->
                <TextBlock x:Name="SecAppearance" x:Uid="SetSectionAppearance" Style="{StaticResource SettingsSectionStyle}" />

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE708;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetThemeTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetThemeDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="ThemeBox_SelectionChanged">
                            <ComboBoxItem x:Uid="SetThemeSystem" Tag="System" />
                            <ComboBoxItem x:Uid="SetThemeLight" Tag="Light" />
                            <ComboBoxItem x:Uid="SetThemeDark" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon Glyph="&#xE2B1;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetAccentTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetAccentDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <!-- Filled with color swatches in code; wraps on narrow windows -->
                        <VariableSizedWrapGrid x:Name="AccentPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" ItemWidth="40" ItemHeight="40" Margin="0,0,0,2" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE771;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetBackdropTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetBackdropDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="BackdropBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="BackdropBox_SelectionChanged">
                            <ComboBoxItem x:Uid="SetBackdropAcrylic" Tag="Acrylic" />
                            <ComboBoxItem x:Uid="SetBackdropMica" Tag="Mica" />
                            <ComboBoxItem x:Uid="SetBackdropSolid" Tag="Solid" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE706;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetGlassTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetGlassDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <Slider x:Name="GlassSlider" Grid.Column="2" Width="200" Minimum="0" Maximum="100" StepFrequency="5" VerticalAlignment="Center" ValueChanged="GlassSlider_ValueChanged" />
                    </Grid>
                </Border>

                <!-- ================= Editor ================= -->
                <TextBlock x:Name="SecEditor" x:Uid="SetSectionEditor" Style="{StaticResource SettingsSectionStyle}" />

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D2;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetFontTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetFontDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox x:Name="FontBox" Width="200" IsEditable="True" SelectionChanged="FontBox_SelectionChanged" TextSubmitted="FontBox_TextSubmitted" />
                            <NumberBox x:Name="FontSizeBox" Width="110" Minimum="8" Maximum="48" SmallChange="1" LargeChange="4" SpinButtonPlacementMode="Compact" ValueChanged="FontSizeBox_ValueChanged" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE751;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetWrapTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetWrapDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="WrapSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D2;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetStatusTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetStatusDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StatusSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xF87B;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetSpellTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetSpellDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SpellSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9E9;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetLineSpacingTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetLineSpacingDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <Slider x:Name="LineSpacingSlider" Grid.Column="2" Width="200" Minimum="1" Maximum="2" StepFrequency="0.05" SmallChange="0.05" VerticalAlignment="Center" ValueChanged="LineSpacingSlider_ValueChanged" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9A9;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetReadableTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetReadableDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ReadableSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <!-- ================= Writing and code ================= -->
                <TextBlock x:Name="SecWriting" x:Uid="SetSectionWriting" Style="{StaticResource SettingsSectionStyle}" />

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D2;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetMarkdownTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetMarkdownDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MarkdownSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A1;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetPreviewTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetPreviewDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="PreviewSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE943;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetSyntaxTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetSyntaxDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SyntaxSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8E9;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetMonoTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetMonoDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MonoSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7B3;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetFocusTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetFocusDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="FocusSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE765;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetTypewriterTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetTypewriterDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TypewriterSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D5;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetGoalTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetGoalDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <NumberBox x:Name="GoalBox" Grid.Column="2" Width="140" Minimum="0" Maximum="1000000" SmallChange="100" LargeChange="500" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ValueChanged="GoalBox_ValueChanged" />
                    </Grid>
                </Border>

                <!-- ================= Code and editing ================= -->
                <TextBlock x:Name="SecEditing" x:Uid="SetSectionEditing" Style="{StaticResource SettingsSectionStyle}" />

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8EF;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetLineNumbersTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetLineNumbersDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="LineNumbersSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7C3;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetLineBandTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetLineBandDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="LineBandSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7A9;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetTabSizeTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetTabSizeDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="TabSizeBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="Combo_SelectionChanged">
                            <ComboBoxItem x:Uid="SetTabChar" Tag="0" />
                            <ComboBoxItem x:Uid="SetTab2" Tag="2" />
                            <ComboBoxItem x:Uid="SetTab4" Tag="4" />
                            <ComboBoxItem x:Uid="SetTab8" Tag="8" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE751;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetAutoIndentTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetAutoIndentDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoIndentSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE943;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetAutoCloseTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetAutoCloseDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoCloseSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7B3;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetSmartHighlightTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetSmartHighlightDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SmartHighlightSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xF6FA;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetSearchEngineTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetSearchEngineDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="SearchEngineBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="Combo_SelectionChanged">
                            <ComboBoxItem Content="Google" Tag="Google" />
                            <ComboBoxItem Content="Bing" Tag="Bing" />
                            <ComboBoxItem Content="DuckDuckGo" Tag="DuckDuckGo" />
                            <ComboBoxItem Content="Яндекс" Tag="Yandex" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ================= Notes ================= -->
                <TextBlock x:Name="SecNotes" x:Uid="SetSectionNotes" Style="{StaticResource SettingsSectionStyle}" />

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE70B;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetLibraryTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetLibraryDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="LibrarySwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE81C;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetHistoryTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetHistoryDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="HistorySwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetFileHistoryTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetFileHistoryDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="FileHistorySwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72E;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetNoteLocksTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetNoteLocksDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="NoteLocksSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE74D;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetClearHistoryTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Name="SetClearHistoryDescText" x:Uid="SetClearHistoryDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <Button x:Name="ClearHistoryButton" x:Uid="SetClearHistoryButton" Grid.Column="2" VerticalAlignment="Center" Click="ClearHistory_Click" />
                    </Grid>
                </Border>

                <!-- ================= Tray and quick note ================= -->
                <TextBlock x:Name="SecTray" x:Uid="SetSectionTray" Style="{StaticResource SettingsSectionStyle}" />

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A7;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetTrayTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetTrayDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TraySwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8BB;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetCloseToTrayTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetCloseToTrayDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="CloseToTraySwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetStartupTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Name="StartupDescText" x:Uid="SetStartupDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="StartupSwitch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE70F;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetQuickNoteTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Name="QuickNoteDescText" x:Uid="SetQuickNoteDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="QuickNoteSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE944;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetMiniTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetMiniDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MiniSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <!-- ================= Files ================= -->
                <TextBlock x:Name="SecFiles" x:Uid="SetSectionFiles" Style="{StaticResource SettingsSectionStyle}" />

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEDE1;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetExportTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetExportDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ExportSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE81C;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetSessionTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetSessionDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SessionSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE78C;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetAutoSaveTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetAutoSaveDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoSaveSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8BB;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetExitLastTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetExitLastDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ExitLastSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE895;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetWatchFilesTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetWatchFilesDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="WatchFilesSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="Switch_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D2;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetNewEncodingTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetNewEncodingDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="NewEncodingBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="Combo_SelectionChanged">
                            <ComboBoxItem Content="UTF-8" Tag="65001:0" />
                            <ComboBoxItem Content="UTF-8 BOM" Tag="65001:1" />
                            <ComboBoxItem Content="UTF-16 LE" Tag="1200:1" />
                            <ComboBoxItem Content="Windows-1251" Tag="1251:0" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE751;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetNewEolTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetNewEolDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="NewEolBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="Combo_SelectionChanged">
                            <ComboBoxItem x:Uid="EolWindowsItem" Tag="CRLF" />
                            <ComboBoxItem x:Uid="EolUnixItem" Tag="LF" />
                            <ComboBoxItem x:Uid="EolMacItem" Tag="CR" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ================= Language ================= -->
                <TextBlock x:Name="SecLanguage" x:Uid="SetSectionLanguage" Style="{StaticResource SettingsSectionStyle}" />

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xF2B7;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SetLanguageTitle" Style="{StaticResource SettingsTitleStyle}" />
                            <TextBlock x:Uid="SetLanguageDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="LanguageBox_SelectionChanged">
                            <ComboBoxItem x:Uid="SetLanguageSystem" Tag="" />
                            <ComboBoxItem Content="English" Tag="en-US" />
                            <ComboBoxItem Content="Українська" Tag="uk-UA" />
                            <ComboBoxItem Content="Русский" Tag="ru-RU" />
                            <ComboBoxItem Content="Deutsch" Tag="de-DE" />
                            <ComboBoxItem Content="Español" Tag="es-ES" />
                            <ComboBoxItem Content="Français" Tag="fr-FR" />
                            <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR" />
                            <ComboBoxItem Content="Italiano" Tag="it-IT" />
                            <ComboBoxItem Content="Polski" Tag="pl-PL" />
                            <ComboBoxItem Content="Türkçe" Tag="tr-TR" />
                            <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                            <ComboBoxItem Content="日本語" Tag="ja-JP" />
                        </ComboBox>
                    </Grid>
                </Border>

                <InfoBar x:Name="RestartBar" x:Uid="SetRestartBar" Severity="Informational" IsClosable="False" Margin="0,4,0,0">
                    <InfoBar.ActionButton>
                        <Button x:Uid="SetRestartButton" Click="Restart_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- ================= Shortcuts ================= -->
                <TextBlock x:Name="SecShortcuts" x:Uid="SetSectionShortcuts" Style="{StaticResource SettingsSectionStyle}" />

                <Border Style="{StaticResource SettingsRowStyle}" Padding="18,8,16,8">
                    <StackPanel x:Name="ShortcutsPanel" />
                </Border>

                <!-- ================= About ================= -->
                <TextBlock x:Name="SecAbout" x:Uid="SetSectionAbout" Style="{StaticResource SettingsSectionStyle}" />

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/AppIcon.png" Width="56" Height="56" Margin="0,4,18,4" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Vellum" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource SettingsDescriptionStyle}" />
                            <TextBlock x:Uid="AboutTagline" Style="{StaticResource SettingsTitleStyle}" Margin="0,8,0,0" />
                            <TextBlock x:Uid="AboutPrivacyNote" Style="{StaticResource SettingsDescriptionStyle}" />
                            <TextBlock x:Name="CopyrightText" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Links: site, studio, Store review, contact, support, privacy (filled in code) -->
                <StackPanel x:Name="AboutLinks" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
