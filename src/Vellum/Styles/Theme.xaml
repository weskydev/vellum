<?xml version="1.0" encoding="utf-8"?>
<!--
    Vellum glass theme.
    The window itself is tinted acrylic (see MainWindow.Backdrop). On top of it lies one
    "glass sheet": the selected tab and the editor share the same translucent brush,
    so they read as a single piece of frosted glass.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GlassSheetBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="GlassCardBrush" Color="#0EFFFFFF" />
            <AcrylicBrush x:Key="FloatingGlassBrush" TintColor="#1D1B19" TintOpacity="0.6" TintLuminosityOpacity="0.88" FallbackColor="#262422" />
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="GlassHoverBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="StatusTextBrush" Color="#8FFFFFFF" />
            <SolidColorBrush x:Key="EditorTextBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="CaptionIconBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="GlassHoverStrongBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="StatusBarBrush" Color="#08FFFFFF" />


            <!-- Tab strip -->
            <SolidColorBrush x:Key="TabViewBackground" Color="Transparent" />
            <StaticResource x:Key="TabViewBorderBrush" ResourceKey="GlassStrokeBrush" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="GlassSheetBrush" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver" ResourceKey="GlassHoverBrush" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundPressed" ResourceKey="GlassHoverBrush" />
            <StaticResource x:Key="TabViewSelectedItemBorderBrush" ResourceKey="GlassStrokeBrush" />
            <StaticResource x:Key="TabViewItemSeparator" ResourceKey="GlassStrokeBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GlassSheetBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="GlassCardBrush" Color="#8CFFFFFF" />
            <AcrylicBrush x:Key="FloatingGlassBrush" TintColor="#FFFFFF" TintOpacity="0.6" TintLuminosityOpacity="0.92" FallbackColor="#F8F7F4" />
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="#14000000" />
            <SolidColorBrush x:Key="GlassHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="StatusTextBrush" Color="#8C1D1B29" />
            <SolidColorBrush x:Key="EditorTextBrush" Color="#E61D1B29" />
            <SolidColorBrush x:Key="CaptionIconBrush" Color="#D91D1B29" />
            <SolidColorBrush x:Key="GlassHoverStrongBrush" Color="#12000000" />
            <SolidColorBrush x:Key="DividerBrush" Color="#12000000" />
            <SolidColorBrush x:Key="StatusBarBrush" Color="#08000000" />


            <SolidColorBrush x:Key="TabViewBackground" Color="Transparent" />
            <StaticResource x:Key="TabViewBorderBrush" ResourceKey="GlassStrokeBrush" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="GlassSheetBrush" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver" ResourceKey="GlassHoverBrush" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundPressed" ResourceKey="GlassHoverBrush" />
            <StaticResource x:Key="TabViewSelectedItemBorderBrush" ResourceKey="GlassStrokeBrush" />
            <StaticResource x:Key="TabViewItemSeparator" ResourceKey="GlassStrokeBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="GlassSheetBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FloatingGlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StatusTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EditorTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CaptionIconBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassHoverStrongBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusBarBrush" Color="{ThemeResource SystemColorWindowColor}" />

        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>


    <!-- Editor text box without its own background, border and focus underline -->
    <Style x:Key="GlassEditorStyle" TargetType="RichEditBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
        <Setter Property="IsTextPredictionEnabled" Value="False" />
        <Setter Property="ClipboardCopyFormat" Value="PlainText" />
        <Setter Property="DisabledFormattingAccelerators" Value="All" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="32,22,32,22" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource EditorTextBrush}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource VellumAccentBrush}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- Quiet text buttons in the status line (language, preview) -->
    <Style x:Key="StatusButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource StatusTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="GlassEditorTextBoxStyle" TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="32,22,32,22" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource EditorTextBrush}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource VellumAccentBrush}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- Thin vertical line between status-line groups -->
    <Style x:Key="StatusSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource DividerBrush}" />
    </Style>

    <!-- A status-line group with a separator on its left; collapses together with its item -->
    <Style x:Key="StatusSegmentStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Padding" Value="4,0,0,0" />
        <Setter Property="Margin" Value="4,3,0,3" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource StatusTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Settings page -->
    <Style x:Key="SettingsSectionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="4,28,0,10" />
    </Style>

    <Style x:Key="SettingsRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,12,16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="MinHeight" Value="64" />
    </Style>

    <Style x:Key="SettingsIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <Style x:Key="SettingsTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource StatusTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!--
        Window buttons (minimize / maximize / close), drawn by Vellum instead of Windows:
        thin line icons on a soft rounded hover pill. The icon is a glyph from the Windows caption icon set.
    -->
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <Border x:Name="Pill" Margin="4,6" CornerRadius="8" Background="Transparent">
                            <Border.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.12" />
                            </Border.BackgroundTransition>
                        </Border>
                        <ContentPresenter x:Name="Icon" Content="{TemplateBinding Content}" Foreground="{ThemeResource CaptionIconBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Background" Value="{ThemeResource GlassHoverStrongBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Background" Value="{ThemeResource GlassHoverBrush}" />
                                        <Setter Target="Icon.Opacity" Value="0.7" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <Border x:Name="Pill" Margin="4,6,8,6" CornerRadius="8" Background="Transparent">
                            <Border.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.12" />
                            </Border.BackgroundTransition>
                        </Border>
                        <ContentPresenter x:Name="Icon" Margin="0,0,4,0" Content="{TemplateBinding Content}" Foreground="{ThemeResource CaptionIconBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Background" Value="#E5484D" />
                                        <Setter Target="Icon.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Background" Value="#C93A3F" />
                                        <Setter Target="Icon.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tabs: not too wide, so many files fit -->
    <x:Double x:Key="TabViewItemMaxWidth">220</x:Double>
    <x:Double x:Key="TabViewItemMinWidth">110</x:Double>

    <!-- Floating glass panels: find bar and command palette -->
    <Style x:Key="FloatingPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FloatingGlassBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="IconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>